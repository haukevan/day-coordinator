generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// ─── User ────────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  supabaseId    String   @unique
  email         String   @unique
  name          String?
  firstName     String?
  lastName      String?
  company       String?
  phone         String?
  phoneVerified Boolean  @default(false)
  avatar        String?
  onboarded     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ownedEvents        Event[]         @relation("EventOwner")
  venues             Venue[]
  assignedTasks     Task[]          @relation("AssignedTo")
  activityLogs      ActivityLog[]
  vendorContacts    VendorContact[] @relation("VendorContacts")
  vendorMemberships EventVendor[]   @relation("VendorMemberships")
}

// ─── Event ───────────────────────────────────────────────────────────────────

model Event {
  id             String        @id @default(cuid())
  title          String
  description    String?
  eventDate      DateTime?
  timezone       String        @default("UTC")
  slug           String?       @unique
  status         EventStatus   @default(DRAFT)
  paymentStatus  PaymentStatus @default(FREE)
  publicTimeline Boolean       @default(false)
  liveStartedAt  DateTime?
  ownerId        String
  owner          User          @relation("EventOwner", fields: [ownerId], references: [id])
  venueId        String?
  venue          Venue?        @relation(fields: [venueId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tasks         Task[]
  notifications Notification[]
  activityLogs  ActivityLog[]
  eventVendors  EventVendor[]
}

enum EventStatus {
  DRAFT
  SCHEDULED
  LIVE
  COMPLETED
  ARCHIVED
}

enum PaymentStatus {
  FREE
  PAID
}

// ─── Task ────────────────────────────────────────────────────────────────────

model Task {
  id               String     @id @default(cuid())
  eventId          String
  event            Event      @relation(fields: [eventId], references: [id])
  title            String
  description      String?
  status           TaskStatus @default(PENDING)
  scheduledStart   DateTime?
  scheduledEnd     DateTime?
  actualStart      DateTime?
  actualEnd        DateTime?
  durationMins     Int?
  manualOverride   Boolean    @default(false)
  sequenceLabel    String?
  publicVisibility Boolean    @default(false)
  parentTaskId     String?
  parentTask       Task?      @relation("TaskDependency", fields: [parentTaskId], references: [id])
  childTasks       Task[]     @relation("TaskDependency")
  assignedToId     String?
  assignedTo       User?      @relation("AssignedTo", fields: [assignedToId], references: [id])
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  activityLogs ActivityLog[]
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DELAYED
  SKIPPED
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id             String              @id @default(cuid())
  eventId        String
  event          Event               @relation(fields: [eventId], references: [id])
  type           NotificationType
  channel        NotificationChannel
  recipient      String
  payload        Json
  status         NotificationStatus  @default(PENDING)
  idempotencyKey String              @unique
  scheduledAt    DateTime?
  sentAt         DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

enum NotificationType {
  TASK_REMINDER
  TASK_DELAYED
  EVENT_STARTED
  CUSTOM
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

// ─── Vendors ─────────────────────────────────────────────────────────────────

model VendorContact {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation("VendorContacts", fields: [ownerId], references: [id])
  email     String
  firstName String?
  lastName  String?
  phone     String?
  company   String?
  jobTitle  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventVendors EventVendor[]

  @@unique([ownerId, email])
}

enum VendorStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model EventVendor {
  id                   String        @id @default(cuid())
  eventId              String
  event                Event         @relation(fields: [eventId], references: [id])
  vendorContactId      String
  vendorContact        VendorContact @relation(fields: [vendorContactId], references: [id])
  userId               String?
  user                 User?         @relation("VendorMemberships", fields: [userId], references: [id])
  company              String?
  jobTitle             String?
  status               VendorStatus  @default(PENDING)
  inviteToken          String?       @unique
  inviteTokenExpiresAt DateTime?
  inviteSentAt         DateTime?
  joinedAt             DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@unique([eventId, vendorContactId])
}

// ─── Activity Log ─────────────────────────────────────────────────────────────

model ActivityLog {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id])
  action    String
  metadata  Json?
  createdAt DateTime @default(now())
}

// ─── Venue ───────────────────────────────────────────────────────────────────

model Venue {
  id          String   @id @default(cuid())
  name        String
  address     String
  description String?
  ownerName   String?
  ownerPhone  String?
  ownerEmail  String?
  lat         Float?
  lng         Float?
  placeId     String?
  creatorId   String
  creator     User     @relation(fields: [creatorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  events Event[]
}

